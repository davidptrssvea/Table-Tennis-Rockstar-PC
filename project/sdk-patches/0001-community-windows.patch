+namespace {
+// Guest XSOCKADDR_IN (big-endian fields) -> host sockaddr_in, with the port mapping applied.
+sockaddr_in ToHost(const XSOCKADDR_IN& guest) {
+  sockaddr_in host{};
+  host.sin_family = AF_INET;
+  host.sin_port = htons(net::HostPort(guest.sin_port));
+  host.sin_addr.s_addr = htonl(guest.sin_addr);
+  return host;
+}
+
+void ToGuest(const sockaddr_in& host, XSOCKADDR_IN* guest) {
+  guest->sin_family = AF_INET;
+  guest->sin_port = net::GuestPort(ntohs(host.sin_port));
+  guest->sin_addr = ntohl(host.sin_addr.s_addr);
+  std::memset(guest->x_sin_zero, 0, sizeof(guest->x_sin_zero));
+}
+
+const char* ProtocolName(XSocket::Protocol proto) {
+  switch (proto) {
+    case XSocket::X_IPPROTO_TCP: return "TCP";
+    case XSocket::X_IPPROTO_UDP: return "UDP";
+    case XSocket::X_IPPROTO_VDP: return "VDP";
+    default: return "?";
+  }
+}
