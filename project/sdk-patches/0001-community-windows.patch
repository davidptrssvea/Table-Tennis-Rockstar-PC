+namespace {
+// 198.18.0.0/15 is reserved for benchmarking and never used on a LAN.
+constexpr uint32_t kSecureBase = 0xC6120000;
+constexpr uint32_t kSecureCount = 0x20000;
+struct Association {
+  uint32_t real;
+  std::array<uint8_t, 8> kid;
+};
+std::mutex association_mutex;
+std::vector<Association> associations;  // index = address - kSecureBase - 1
+}  // namespace
+
+uint32_t SecureAddress(uint32_t real, const uint8_t kid[8]) {
+  std::lock_guard<std::mutex> lock(association_mutex);
+  for (size_t i = 0; i < associations.size(); ++i) {
+    if (associations[i].real == real && std::memcmp(associations[i].kid.data(), kid, 8) == 0) {
+      return kSecureBase + uint32_t(i) + 1;
+    }
+  }
+  if (associations.size() + 1 >= kSecureCount) return real;
+  Association association{real, {}};
+  std::memcpy(association.kid.data(), kid, 8);
+  associations.push_back(association);
+  const uint32_t address = kSecureBase + uint32_t(associations.size());
+  REXKRNL_INFO("XNet: {} in session {:016X} is {}", FormatAddress(real),
+               memory::load_and_swap<uint64_t>(kid), FormatAddress(address));
+  return address;
+}
+
+bool ResolveSecureAddress(uint32_t address, uint32_t* real, uint8_t kid[8]) {
+  if (address <= kSecureBase || address >= kSecureBase + kSecureCount) return false;
+  std::lock_guard<std::mutex> lock(association_mutex);
+  const size_t index = address - kSecureBase - 1;
+  if (index >= associations.size()) return false;
+  *real = associations[index].real;
+  std::memcpy(kid, associations[index].kid.data(), 8);
+  return true;
+}
+
+bool CurrentSessionKey(uint8_t kid[8]) {
+  std::lock_guard<std::mutex> lock(session_key_mutex);
+  if (session_keys.empty()) return false;
+  std::memcpy(kid, session_keys.back().data(), 8);
+  return true;
+}
