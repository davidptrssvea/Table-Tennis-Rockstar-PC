+// QoS: the title measures the latency to a session it found (XNetQosLookup) and reads the data
+// the host published with XNetQosListen. Hosts answer probes on UDP port kQosPort (guest port;
+// the net_port_offset applies), using the same address rules as title sockets.
+namespace qos {
+constexpr uint16_t kQosPort = 3075;
+constexpr uint32_t kRequest = 0x54545131;   // "TTQ1"
+constexpr uint32_t kResponse = 0x54545231;  // "TTR1"
+constexpr size_t kMaxData = 1024;
+
+// XNQOSINFO flags
+constexpr uint8_t kComplete = 0x01;
+constexpr uint8_t kTargetContacted = 0x02;
+constexpr uint8_t kDataReceived = 0x08;
+
+std::mutex mutex;
+std::vector<uint8_t> listen_data;
+bool listening = false;
+std::atomic<bool> server_started{false};
+
+sockaddr_in QosAddress(uint32_t address) {
+  sockaddr_in addr{};
+  addr.sin_family = AF_INET;
+  addr.sin_port = htons(rex::system::net::HostPort(kQosPort));
+  addr.sin_addr.s_addr = htonl(address);
+  return addr;
+}
+
+void Serve() {
+  rex::net::SocketHandle fd = ::socket(AF_INET, SOCK_DGRAM, 0);
+  sockaddr_in local = QosAddress(rex::system::net::BindLocalAddress() ? rex::system::net::BaseAddress() : INADDR_ANY);
+  if (fd < 0 || ::bind(fd, reinterpret_cast<sockaddr*>(&local), sizeof(local)) < 0) {
+    REXKRNL_ERROR("XNetQos: cannot listen on UDP port {}: {}", ntohs(local.sin_port),
+                  std::strerror(errno));
+    if (fd >= 0) rex::net::socket_close(fd);
+    return;
+  }
+  REXKRNL_INFO("XNetQos: answering probes on UDP port {}", ntohs(local.sin_port));
+  uint8_t packet[16 + kMaxData];
+  while (true) {
+    sockaddr_in from{};
+    auto from_len = int(sizeof(from));
+    auto len = ::recvfrom(fd, reinterpret_cast<char*>(packet), sizeof(packet), 0, reinterpret_cast<sockaddr*>(&from),
+                             &from_len);
+    if (len < 16 || memory::load_and_swap<uint32_t>(packet) != kRequest) continue;
+    size_t reply_len = 16;
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      if (!listening) continue;
+      memory::store_and_swap<uint32_t>(packet, kResponse);
+      std::memcpy(packet + 16, listen_data.data(), listen_data.size());
+      reply_len += listen_data.size();
+    }
+    ::sendto(fd, reinterpret_cast<char*>(packet), int(reply_len), 0, reinterpret_cast<sockaddr*>(&from), from_len);
+  }
+}
+
+struct Lookup {
+  bool released = false;
+  bool done = false;
+  std::vector<uint32_t> allocations;  // guest blocks (XNQOS first)
+};
+std::map<uint32_t, Lookup> lookups;
+
+void Free(Lookup& lookup) {
+  for (uint32_t block : lookup.allocations) {
+    REX_KERNEL_MEMORY()->SystemHeapFree(block);
+  }
+}
+
+// Probes one target; returns the round trip in ms (or -1) and its QoS data.
+int Probe(uint32_t address, uint32_t probes, std::vector<uint8_t>* data, uint32_t* received) {
+  rex::net::SocketHandle fd = ::socket(AF_INET, SOCK_DGRAM, 0);
+  if (fd < 0) return -1;
+  if (rex::system::net::BindLocalAddress()) {
+    sockaddr_in local = QosAddress(rex::system::net::BaseAddress());
+    local.sin_port = 0;
+    ::bind(fd, reinterpret_cast<sockaddr*>(&local), sizeof(local));
+  }
+#if REX_PLATFORM_WIN32
+  DWORD timeout=100;
+#else
+  timeval timeout{0,100000};
+#endif
+  setsockopt(fd,SOL_SOCKET,SO_RCVTIMEO,reinterpret_cast<const char*>(&timeout),sizeof(timeout));
+  sockaddr_in to = QosAddress(address);
+  using clock = std::chrono::steady_clock;
+  std::vector<int> rtts;
+  for (uint32_t i = 0; i < std::max(probes, 2u); ++i) {
+    uint8_t request[16] = {};
+    memory::store_and_swap<uint32_t>(request, kRequest);
+    memory::store_and_swap<uint32_t>(request + 4, i);
+    auto sent_at = clock::now();
+    ::sendto(fd, reinterpret_cast<const char*>(request), sizeof(request), 0, reinterpret_cast<sockaddr*>(&to), sizeof(to));
+    uint8_t reply[16 + kMaxData];
+    auto len = ::recv(fd, reinterpret_cast<char*>(reply), sizeof(reply), 0);
+    if (len >= 16 && memory::load_and_swap<uint32_t>(reply) == kResponse) {
+      rtts.push_back(int(std::chrono::duration_cast<std::chrono::milliseconds>(clock::now() -
+                                                                              sent_at)
+                             .count()));
+      data->assign(reply + 16, reply + len);
+    }
+  }
+  rex::net::socket_close(fd);
+  *received = uint32_t(rtts.size());
+  if (rtts.empty()) return -1;
+  std::sort(rtts.begin(), rtts.end());
+  return rtts[rtts.size() / 2];
+}
