+uint32_t LastError() {
+#if REX_PLATFORM_WIN32
+  return WSAGetLastError();
+#else
+  switch (errno) {
+    case EINTR: return 10004;         // WSAEINTR
+    case EBADF: return 10009;         // WSAEBADF
+    case EACCES: return 10013;        // WSAEACCES
+    case EFAULT: return 10014;        // WSAEFAULT
+    case EINVAL: return 10022;        // WSAEINVAL
+    case EMFILE: return 10024;        // WSAEMFILE
+#if EAGAIN != EWOULDBLOCK
+    case EAGAIN:
+#endif
+    case EWOULDBLOCK: return 10035;   // WSAEWOULDBLOCK
+    case EINPROGRESS: return 10035;   // non-blocking connect: Winsock reports WSAEWOULDBLOCK
+    case EALREADY: return 10037;      // WSAEALREADY
+    case ENOTSOCK: return 10038;      // WSAENOTSOCK
+    case EDESTADDRREQ: return 10039;  // WSAEDESTADDRREQ
+    case EMSGSIZE: return 10040;      // WSAEMSGSIZE
+    case ENOPROTOOPT: return 10042;   // WSAENOPROTOOPT
+    case EOPNOTSUPP: return 10045;    // WSAEOPNOTSUPP
+    case EADDRINUSE: return 10048;    // WSAEADDRINUSE
+    case EADDRNOTAVAIL: return 10049; // WSAEADDRNOTAVAIL
+    case ENETDOWN: return 10050;      // WSAENETDOWN
+    case ENETUNREACH: return 10051;   // WSAENETUNREACH
+    case ECONNABORTED: return 10053;  // WSAECONNABORTED
+    // A UDP socket reports an ICMP port unreachable as ECONNREFUSED on Linux and as
+    // WSAECONNRESET on Windows and the console.
+    case ECONNREFUSED: return 10054;  // WSAECONNRESET
+    case ECONNRESET: return 10054;    // WSAECONNRESET
+    case ENOBUFS: return 10055;       // WSAENOBUFS
+    case EISCONN: return 10056;       // WSAEISCONN
+    case ENOTCONN: return 10057;      // WSAENOTCONN
+    case ETIMEDOUT: return 10060;     // WSAETIMEDOUT
+    case EHOSTUNREACH: return 10065;  // WSAEHOSTUNREACH
+    default: return 10022;
+  }
+#endif
+}
+
+// --- Online play ----------------------------------------------------------------------------
+// Client of server/ttlink_server.py. All messages start with "TTV1" and a type byte; fields
+// are big-endian. Server messages: HELLO/WELCOME (join a room, get an id, a room address and a
+// token), MEMBERS (the other players: id, room address, token, public and local endpoint,
+// name), KEEPALIVE/STATUS, DATA/RELAYED (datagrams relayed or broadcast to the room), BYE,
+// ERROR. Between players: PUNCH/PUNCH_ACK (open a direct path through both NATs) and DIRECT
+// (a datagram sent straight to the other player).
+namespace {
+constexpr uint8_t kOnlineMagic[4] = {'T', 'T', 'V', '1'};
+enum OnlineMessage : uint8_t {
+  kHello = 1, kWelcome, kMembers, kKeepAlive, kStatus, kData, kRelayed, kBye, kPunch,
+  kPunchAck, kDirect, kError,
+};
+constexpr uint16_t kDefaultServerPort = 27360;
+constexpr uint32_t kOnlineBroadcast = 0xFFFFFFFF;
+constexpr size_t kMaxOnlinePayload = 1400;
+// Source port flag of a tagged match datagram (see OnlineClient::Send); title ports stay below.
+constexpr uint16_t kTaggedPort = 0x8000;
+
+using OnlineClock = std::chrono::steady_clock;
+
+struct Writer {
+  std::vector<uint8_t> data;
+  explicit Writer(uint8_t type) {
+    data.assign(kOnlineMagic, kOnlineMagic + 4);
+    data.push_back(type);
+  }
+  void u8(uint8_t v) { data.push_back(v); }
+  void u16(uint16_t v) { u8(uint8_t(v >> 8)); u8(uint8_t(v)); }
+  void u32(uint32_t v) { u16(uint16_t(v >> 16)); u16(uint16_t(v)); }
+  void u64(uint64_t v) { u32(uint32_t(v >> 32)); u32(uint32_t(v)); }
+  void str(const std::string& v) {
+    const size_t n = std::min<size_t>(v.size(), 255);
+    u8(uint8_t(n));
+    data.insert(data.end(), v.begin(), v.begin() + n);
+  }
+  void bytes(const uint8_t* p, size_t n) { data.insert(data.end(), p, p + n); }
+};
+
+struct Reader {
+  const uint8_t* p;
+  size_t n;
+  size_t pos = 0;
+  bool ok = true;
+  bool need(size_t k) {
+    if (pos + k > n) ok = false;
+    return ok;
+  }
+  uint8_t u8() { return need(1) ? p[pos++] : 0; }
+  uint16_t u16() { uint16_t hi = u8(); return uint16_t((hi << 8) | u8()); }
+  uint32_t u32() { uint32_t hi = u16(); return (hi << 16) | u16(); }
+  uint64_t u64() { uint64_t hi = u32(); return (hi << 32) | u32(); }
+  std::string str() {
+    const size_t k = u8();
+    if (!need(k)) return {};
+    std::string v(reinterpret_cast<const char*>(p + pos), k);
+    pos += k;
+    return v;
+  }
+};
+
+sockaddr_in Endpoint(uint32_t ip, uint16_t port) {
+  sockaddr_in a{};
+  a.sin_family = AF_INET;
+  a.sin_addr.s_addr = htonl(ip);
+  a.sin_port = htons(port);
+  return a;
+}
+
+bool SameEndpoint(const sockaddr_in& a, const sockaddr_in& b) {
+  return a.sin_addr.s_addr == b.sin_addr.s_addr && a.sin_port == b.sin_port;
+}
+
+// Sockets the title bound, by guest port, to hand them the datagrams that arrive online.
+std::mutex bound_mutex;
+std::vector<std::pair<uint16_t, XSocket*>> bound_sockets;
+
+class OnlineClient {
+ public:
+  static OnlineClient& Get() {
+    static OnlineClient* client = new OnlineClient();  // lives for the whole process
+    return *client;
+  }
+
+  void Configure(const std::string& mode, const std::string& room) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (mode != mode_ || room != room_) {
+      state_ = mode == "public" || mode == "room" ? "CONNECTING" : "OFF";
+    }
+    mode_ = mode;
+    room_ = room;
+  }
+
+  bool Enabled() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return mode_ == "public" || mode_ == "room";
+  }
+
+  uint32_t Address() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return welcomed_ ? vip_ : 0;
+  }
+
+  int PeerRtt(uint32_t vip) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    for (const auto& peer : peers_) {
+      if (peer.vip != vip) continue;
+      if (peer.rtt_ms >= 0) return int(peer.rtt_ms + 0.5);
+      return server_rtt_ms_ >= 0 ? server_rtt_ms_ * 2 : 100;
+    }
+    return -1;
+  }
+
+  OnlineStatus Status() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    OnlineStatus status;
+    status.mode = mode_;
+    status.room = mode_ == "room" ? room_ : "";
+    status.state = state_;
+    status.connected = welcomed_;
+    status.room_players = welcomed_ ? std::max(room_players_, int(peers_.size()) + 1) : 0;
+    status.players_online = players_online_;
+    status.server_rtt_ms = server_rtt_ms_;
+    status.nearby_players = nearby_players_;
+    const auto now = OnlineClock::now();
+    OnlineClock::time_point latest{};
+    for (const auto& peer : peers_) {
+      (peer.direct && !relay_only_ ? status.direct_peers : status.relayed_peers)++;
+      OnlinePeerQuality quality;
+      quality.name = peer.name;
+      quality.rtt_ms = peer.rtt_ms < 0 ? -1 : int(peer.rtt_ms + 0.5);
+      quality.loss = Loss(peer, now);
+      quality.direct = peer.direct && !relay_only_;
+      quality.redundant = peer.redundant;
+      // The opponent: the member the title sent match traffic to most recently (5 s), or the
+      // only member.
+      if (now - peer.last_game < std::chrono::seconds(5) && peer.last_game > latest) {
+        latest = peer.last_game;
+        status.opponent = int(status.peers.size());
+      }
+      status.peers.push_back(quality);
+    }
+    if (status.opponent < 0 && status.peers.size() == 1) status.opponent = 0;
+    return status;
+  }
+
+  // A datagram from the title: to a room member (directly or relayed) or to the whole room.
+  void Send(uint32_t dest, uint16_t src_port, uint16_t dst_port, const uint8_t* data, size_t len) {
+    if (len > kMaxOnlinePayload) return;
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!welcomed_ || fd_ < 0) return;
+    const bool broadcast = dest == kOnlineBroadcast || (dest & 0xFF) == 0xFF;
+    if (!broadcast) {
+      for (auto& peer : peers_) {
+        if (peer.vip != dest) continue;
+        peer.last_game = OnlineClock::now();
+        if (!peer.tags || src_port & kTaggedPort || len + 4 > kMaxOnlinePayload) break;
+        // Tagged: the source port gets kTaggedPort and the payload starts with the sequence
+        // number (top bit set on the second copy).
+        const uint32_t seq = ++peer.send_seq & 0x7FFFFFFF;
+        for (const bool second : {false, true}) {
+          if (second && !peer.redundant) break;
+          const bool direct = peer.direct && !relay_only_;
+          Writer w(direct ? kDirect : kData);
+          w.u32(id_);
+          w.u64(token_);
+          if (!direct) w.u32(dest);
+          w.u16(src_port | kTaggedPort);
+          w.u16(dst_port);
+          w.u32(second ? seq | 0x80000000u : seq);
+          w.bytes(data, len);
+          SendRaw(direct ? peer.direct_addr : server_, w.data,
+                  second ? std::max(0, REXCVAR_GET(online_redundancy_delay_ms)) : 0);
+        }
+        return;
+      }
+      for (auto& peer : peers_) {
+        if (peer.vip != dest || !peer.direct || relay_only_) continue;
+        Writer w(kDirect);
+        w.u32(id_);
+        w.u64(token_);
+        w.u16(src_port);
+        w.u16(dst_port);
+        w.bytes(data, len);
+        SendRaw(peer.direct_addr, w.data);
+        return;
+      }
+    }
+    Writer w(kData);
+    w.u32(id_);
+    w.u64(token_);
+    w.u32(broadcast ? kOnlineBroadcast : dest);
+    w.u16(src_port);
+    w.u16(dst_port);
+    w.bytes(data, len);
+    SendRaw(server_, w.data);
+  }
+
+ private:
+  struct Peer {
+    uint32_t id = 0;
+    uint32_t vip = 0;
+    uint64_t token = 0;
+    std::string name;
+    sockaddr_in public_addr{};
+    sockaddr_in local_addr{};
+    sockaddr_in direct_addr{};
+    bool direct = false;
+    OnlineClock::time_point seen;           // first listed
+    OnlineClock::time_point last_listed{};
+    OnlineClock::time_point last_punch{};
+    OnlineClock::time_point last_direct{};  // last packet received directly
+    OnlineClock::time_point last_game{};    // last match datagram the title sent to it
+    // Quality: pings once a second over the path in use (port 0 is reserved for them).
+    uint32_t ping_seq = 0;
+    OnlineClock::time_point last_ping{};
+    struct PingRecord {
+      uint32_t seq;
+      OnlineClock::time_point sent;
+      bool answered;
+    };
+    std::deque<PingRecord> pings;  // the last 20
+    double rtt_ms = -1.0;          // smoothed
+    // Tagged datagrams (both sides newer than plain DIRECT/DATA, announced in pings): match
+    // datagrams carry a sequence number so second copies can be sent and dropped on arrival.
+    bool tags = false;
+    uint32_t send_seq = 0;
+    bool receiving = false;        // recv_max is valid
+    uint32_t recv_max = 0;         // highest sequence received
+    uint64_t recv_seen[4] = {};    // the 256 sequences up to recv_max: bit set = received
+    uint32_t window_start = 0;     // loss of first copies from this player, measured over
+    uint32_t window_firsts = 0;    // windows of sequences
+    uint32_t window_delivered = 0; // ... and of datagrams the title got (either copy)
+    int incoming_loss_pct = -1;    // last measurement, sent back in pings; -1 unknown
+    int residual_loss_pct = -1;    // datagrams of which neither copy arrived
+    uint64_t total_expected = 0, total_firsts = 0, total_delivered = 0;  // for the log
+    int reported_loss_pct = -1;    // what the player reports receiving from us
+    OnlineClock::time_point reported_at{};
+    bool redundant = false;        // second copies are being sent
+    OnlineClock::time_point last_loss{};
+  };
+
+  // Share of the recent pings (older than 2 s, so their answers had time) without an answer.
+  static float Loss(const Peer& peer, OnlineClock::time_point now) {
+    int sent = 0, lost = 0;
+    for (const auto& ping : peer.pings) {
+      if (now - ping.sent < std::chrono::seconds(2)) continue;
+      ++sent;
+      if (!ping.answered) ++lost;
+    }
+    return sent ? float(lost) / float(sent) : 0.0f;
+  }
+
+  // Ping/pong between room members, in DIRECT or DATA/RELAYED messages to port 0:
+  // u8 kind (1 ping, 2 pong), u32 sequence, u64 sender's clock in microseconds (echoed).
+  static constexpr uint16_t kControlPort = 0;
+  static uint64_t NowMicros() {
+    return uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                        OnlineClock::now().time_since_epoch())
+                        .count());
+  }
+
+  void SendToPeer(const Peer& peer, uint16_t dst_port, const uint8_t* data, size_t len) {
+    if (peer.direct && !relay_only_) {
+      Writer w(kDirect);
+      w.u32(id_);
+      w.u64(token_);
+      w.u16(0);
+      w.u16(dst_port);
+      w.bytes(data, len);
+      SendRaw(peer.direct_addr, w.data);
+    } else {
+      Writer w(kData);
+      w.u32(id_);
+      w.u64(token_);
+      w.u32(peer.vip);
+      w.u16(0);
+      w.u16(dst_port);
+      w.bytes(data, len);
+      SendRaw(server_, w.data);
+    }
+  }
+
+  // Pings and pongs carry two more bytes after the 13 above, which older clients ignore and
+  // leave out of their pongs: bit 0 = speaks tagged datagrams, and the share (percent, 255 =
+  // unknown) of first copies lost on the way from that player.
+  static constexpr uint8_t kTagsCapability = 1;
+  static constexpr size_t kControlSize = 15;
+  void SendPing(Peer& peer, OnlineClock::time_point now) {
+    uint8_t message[kControlSize];
+    message[0] = 1;
+    message[13] = kTagsCapability;
+    message[14] = peer.incoming_loss_pct < 0 ? 255 : uint8_t(peer.incoming_loss_pct);
+    const uint32_t seq = ++peer.ping_seq;
+    const uint64_t t = NowMicros();
+    for (int i = 0; i < 4; ++i) message[1 + i] = uint8_t(seq >> (24 - 8 * i));
+    for (int i = 0; i < 8; ++i) message[5 + i] = uint8_t(t >> (56 - 8 * i));
+    peer.pings.push_back({seq, now, false});
+    while (peer.pings.size() > 20) peer.pings.pop_front();
+    peer.last_ping = now;
+    SendToPeer(peer, kControlPort, message, sizeof(message));
+  }
+
+  void HandleControl(Peer* peer, const uint8_t* data, size_t len) {
+    if (!peer || len < 13) return;
+    if (len >= kControlSize) {
+      peer->tags = (data[13] & kTagsCapability) != 0;
+      if (data[14] <= 100) {
+        peer->reported_loss_pct = data[14];
+        peer->reported_at = OnlineClock::now();
+      }
+    }
+    if (data[0] == 1) {
+      uint8_t reply[kControlSize];
+      std::memcpy(reply, data, 13);
+      reply[0] = 2;
+      reply[13] = kTagsCapability;
+      reply[14] = peer->incoming_loss_pct < 0 ? 255 : uint8_t(peer->incoming_loss_pct);
+      SendToPeer(*peer, kControlPort, reply, sizeof(reply));
+    } else if (data[0] == 2) {
+      uint32_t seq = 0;
+      uint64_t t = 0;
+      for (int i = 0; i < 4; ++i) seq = (seq << 8) | data[1 + i];
+      for (int i = 0; i < 8; ++i) t = (t << 8) | data[5 + i];
+      for (auto& ping : peer->pings) {
+        if (ping.seq != seq || ping.answered) continue;
+        ping.answered = true;
+        const double rtt = double(NowMicros() - t) / 1000.0;
+        peer->rtt_ms = peer->rtt_ms < 0 ? rtt : peer->rtt_ms * 0.8 + rtt * 0.2;
+        break;
+      }
+    }
+  }
+
+  // Test conditions (online_test_delay_ms, online_test_loss_percent): packets wait in a queue
+  // and a sender thread sends them when due.
+  struct Delayed {
+    OnlineClock::time_point due;
+    sockaddr_in to;
+    std::vector<uint8_t> data;
+    uint64_t generation;
+  };
+  std::mutex delay_mutex_;
+  std::condition_variable delay_cv_;
+  std::deque<Delayed> delayed_;
+  bool delay_thread_ = false;
+
+  void DelayLoop() {
+    std::unique_lock<std::mutex> lock(delay_mutex_);
+    while (true) {
+      if (delayed_.empty()) {
+        delay_cv_.wait(lock);
+        continue;
+      }
+      const auto due = delayed_.front().due;
+      if (OnlineClock::now() < due) {
+        delay_cv_.wait_until(lock, due);
+        continue;
+      }
+      Delayed next = std::move(delayed_.front());
+      delayed_.pop_front();
+      lock.unlock();
+      {
+        // Socket lifetime belongs to mutex_, not delay_mutex_. A room change
+        // must not send queued packets through a closed or newly reused socket.
+        std::lock_guard<std::mutex> socket_lock(mutex_);
+        if (next.data.size() >= 5 && next.data[4] == kHello)
+          REXKRNL_DEBUG("Online: delayed HELLO generation {} (current {}), socket {}",
+                        next.generation, socket_generation_, fd_);
+        if (next.generation == socket_generation_) WireSend(fd_, next.to, next.data);
+      }
+      lock.lock();
+    }
+  }
+
+  OnlineClient() {
+    mode_ = REXCVAR_GET(online);
+    room_ = REXCVAR_GET(room_code);
+    std::thread([this] { Run(); }).detach();
+  }
+
+  // Sends now, or after extra_ms (second copies) plus the test delay, from the sender thread.
+  void SendRaw(const sockaddr_in& to, const std::vector<uint8_t>& data, int extra_ms = 0) {
+    const int loss = REXCVAR_GET(online_test_loss_percent);
+    if (loss > 0 && int(std::random_device{}() % 100) < loss) return;
+    const int delay = std::max(0, REXCVAR_GET(online_test_delay_ms)) + extra_ms;
+    if (data.size() >= 5 && data[4] == kHello)
+      REXKRNL_DEBUG("Online: queue HELLO generation {}, socket {}, delay {} ms",
+                    socket_generation_, fd_, delay);
+    if (delay > 0) {
+      std::lock_guard<std::mutex> lock(delay_mutex_);
+      if (!delay_thread_) {
+        delay_thread_ = true;
+        std::thread([this] { DelayLoop(); }).detach();
+      }
+      // Keep the queue in send order (second copies are due later than what follows them).
+      const auto due = OnlineClock::now() + std::chrono::milliseconds(delay);
+      auto it = delayed_.end();
+      while (it != delayed_.begin() && std::prev(it)->due > due) --it;
+      if (delayed_.size() >= 4096) return;
+      delayed_.insert(it, {due, to, data, socket_generation_});
+      delay_cv_.notify_one();
+      return;
+    }
+    WireSend(fd_, to, data);
+  }
+
+  // online_test_burst: within every PERIOD ms, LENGTH ms (starting at a random moment) in
+  // which nothing this machine sends arrives.
+  bool InTestBurst() {
+    const std::string burst = REXCVAR_GET(online_test_burst);
+    if (burst.empty()) return false;
+    const int period = std::atoi(burst.c_str());
+    const size_t colon = burst.find(':');
+    const int length = colon == std::string::npos ? 0 : std::atoi(burst.c_str() + colon + 1);
+    if (period <= 0 || length <= 0) return false;
+    std::lock_guard<std::mutex> lock(burst_mutex_);
+    const auto now = OnlineClock::now();
+    if (now >= burst_period_end_) {
+      burst_period_end_ = now + std::chrono::milliseconds(period);
+      const int start = int(std::random_device{}() % unsigned(std::max(1, period - length)));
+      burst_start_ = now + std::chrono::milliseconds(start);
+      burst_end_ = burst_start_ + std::chrono::milliseconds(length);
+    }
+    return now >= burst_start_ && now < burst_end_;
+  }
+  std::mutex burst_mutex_;
+  OnlineClock::time_point burst_period_end_{}, burst_start_{}, burst_end_{};
+
+  void WireSend(rex::net::SocketHandle fd, const sockaddr_in& to, const std::vector<uint8_t>& data) {
+    if (fd < 0 || InTestBurst()) return;
+    const int sent = sendto(fd, reinterpret_cast<const char*>(data.data()), int(data.size()), 0,
+                           reinterpret_cast<const sockaddr*>(&to), sizeof(to));
+    if (data.size() >= 5 && data[4] == kHello)
+      REXKRNL_DEBUG("Online: HELLO send result {} to {}:{}", sent,
+                    FormatAddress(ntohl(to.sin_addr.s_addr)), ntohs(to.sin_port));
+    if (sent < 0 && OnlineClock::now() - last_send_error_ > std::chrono::seconds(2)) {
+      last_send_error_ = OnlineClock::now();
+      REXKRNL_WARN("Online: UDP send failed (socket {}, error {})", fd, LastError());
+    }
+  }
+
+  // Reads the online_server setting; false when none is set or it cannot be resolved.
+  bool ResolveServer() {
+    std::string text = REXCVAR_GET(online_server);
+    if (text.empty()) return false;
+    uint16_t port = kDefaultServerPort;
+    const size_t colon = text.rfind(':');
+    if (colon != std::string::npos) {
+      const std::string digits = text.substr(colon + 1);
+      if (digits.empty() || digits.size() > 5 ||
+          digits.find_first_not_of("0123456789") != std::string::npos) return false;
+      const unsigned long parsed = std::strtoul(digits.c_str(), nullptr, 10);
+      if (!parsed || parsed > 65535) return false;
+      port = uint16_t(parsed);
+      text.resize(colon);
+    }
+    if (text.empty()) return false;
+    addrinfo hints{};
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_DGRAM;
+    addrinfo* result = nullptr;
+    if (getaddrinfo(text.c_str(), nullptr, &hints, &result) != 0 || !result) return false;
+    server_ = *reinterpret_cast<sockaddr_in*>(result->ai_addr);
+    server_.sin_port = htons(port);
+    freeaddrinfo(result);
+    return true;
+  }
+
+  void Disconnect() {
+    if (fd_ >= 0) {
+      if (welcomed_) {
+        Writer w(kBye);
+        w.u32(id_);
+        w.u64(token_);
+        WireSend(fd_, server_, w.data); // Do not leave BYE in a queue we are about to discard.
+      }
+      rex::net::socket_close(fd_);
+    }
+    fd_ = -1;
+    ++socket_generation_;
+    { std::lock_guard<std::mutex> lock(delay_mutex_); delayed_.clear(); }
+    welcomed_ = false;
+    resolved_ = false;
+    peers_.clear();
+    room_players_ = 0;
+  }
+
+  void Run() {
+    std::string active_mode, active_room, active_server;
+    uint8_t buffer[2048];
+    while (true) {
+      std::unique_lock<std::mutex> lock(mutex_);
+      const auto now = OnlineClock::now();
+      const bool on = mode_ == "public" || mode_ == "room";
+      const std::string server = REXCVAR_GET(online_server);
+      if (mode_ != active_mode || room_ != active_room || server != active_server) {
+        if (!active_mode.empty() && fd_ >= 0) {
+          REXKRNL_INFO("Online: settings changed ({} {}), reconnecting", mode_, room_);
+        }
+        Disconnect();
+        active_mode = mode_;
+        active_room = room_;
+        active_server = server;
+        hello_nonce_ = (uint64_t(std::random_device{}()) << 32) | std::random_device{}();
+      }
+      relay_only_ = REXCVAR_GET(online_relay_only);
+      if (!on) {
+        state_ = "OFF";
+        lock.unlock();
+        std::this_thread::sleep_for(std::chrono::milliseconds(200));
+        continue;
+      }
+      if (server.empty()) {
+        state_ = "NO SERVER SET";
+        lock.unlock();
+        std::this_thread::sleep_for(std::chrono::milliseconds(500));
+        continue;
+      }
+      if (mode_ == "room" && !ValidRoom(room_)) {
+        state_ = "ENTER A ROOM CODE";
+        lock.unlock();
+        std::this_thread::sleep_for(std::chrono::milliseconds(300));
+        continue;
+      }
+      if (!resolved_) {
+        if (now < next_resolve_) {
+          lock.unlock();
+          std::this_thread::sleep_for(std::chrono::milliseconds(200));
+          continue;
+        }
+        resolved_ = ResolveServer();
+        if (!resolved_) {
+          state_ = "SERVER NOT FOUND";
+          next_resolve_ = now + std::chrono::seconds(10);
+          continue;
+        }
+      }
+      if (fd_ < 0) {
