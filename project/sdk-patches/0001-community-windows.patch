+                                   MSG_DONTWAIT, reinterpret_cast<sockaddr*>(&from), &from_len);
+        if (n < 5) break;
+        if (std::memcmp(buffer, kOnlineMagic, 4) != 0) continue;
+        Handle(buffer[4], buffer + 5, size_t(n - 5), from);
+      }
+    }
+  }
+
+  static bool ValidRoom(const std::string& room) {
+    static const char* alphabet = "ABCDEFGHJKMNPQRSTUVWXYZ23456789";
+    if (room.size() != 6) return false;
+    for (char c : room) {
+      if (!std::strchr(alphabet, c)) return false;
+    }
+    return true;
+  }
+
+  // Opens and keeps direct paths: every new peer gets punches to its public and local
+  // endpoints twice a second for 15 s (then every 5 s); a direct peer gets one every 5 s to
+  // keep the NAT mappings open, and falls back to the relay after 15 s of silence.
+  void Punch(OnlineClock::time_point now) {
+    if (relay_only_) return;
+    for (auto& peer : peers_) {
+      if (peer.direct && now - peer.last_direct > std::chrono::seconds(15)) {
+        REXKRNL_INFO("Online: direct path to {} lost, using the server", peer.name);
+        peer.direct = false;
+      }
+      const auto interval = peer.direct || now - peer.seen > std::chrono::seconds(15)
+                                ? std::chrono::milliseconds(5000)
+                                : std::chrono::milliseconds(500);
+      if (now - peer.last_punch < interval) continue;
+      peer.last_punch = now;
+      Writer w(kPunch);
+      w.u32(id_);
+      w.u64(token_);
+      w.u32(peer.id);
+      if (peer.direct) {
+        SendRaw(peer.direct_addr, w.data);
+      } else {
+        SendRaw(peer.public_addr, w.data);
+        if (peer.local_addr.sin_port && !SameEndpoint(peer.local_addr, peer.public_addr)) {
+          SendRaw(peer.local_addr, w.data);
+        }
+      }
+    }
+  }
+
+  Peer* FindPeer(uint32_t id, uint64_t token) {
+    for (auto& peer : peers_) {
+      if (peer.id == id && peer.token == token) return &peer;
+    }
+    return nullptr;
+  }
+
+  // Strips the tag of a match datagram; false for a copy that already arrived (or one too old
+  // to tell), which the title never sees. Counts first copies for the loss measurement.
+  static bool Untag(Peer& peer, uint16_t& src_port, const uint8_t*& payload, size_t& len) {
+    if (len < 4) return false;
+    const uint32_t word = uint32_t(payload[0]) << 24 | uint32_t(payload[1]) << 16 |
+                          uint32_t(payload[2]) << 8 | payload[3];
+    const bool second = word & 0x80000000u;
+    const uint32_t seq = word & 0x7FFFFFFF;
+    payload += 4;
+    len -= 4;
+    src_port &= uint16_t(~kTaggedPort);
+    constexpr uint32_t kWindow = 256;
+    auto bit = [&](uint32_t s) -> uint64_t& { return peer.recv_seen[(s / 64) % 4]; };
+    if (!peer.receiving || seq > peer.recv_max + 100000 || seq + 100000 < peer.recv_max) {
+      // First datagram, or the sender restarted its numbering.
+      peer.receiving = true;
+      peer.recv_max = seq;
+      std::memset(peer.recv_seen, 0, sizeof(peer.recv_seen));
+      peer.window_start = seq;
+      peer.window_firsts = 0;
+      peer.window_delivered = 0;
+    } else if (seq > peer.recv_max) {
+      for (uint32_t s = peer.recv_max + 1; s <= seq && s - peer.recv_max <= kWindow; ++s) {
+        bit(s) &= ~(uint64_t(1) << (s % 64));
+      }
+      if (seq - peer.recv_max > kWindow) std::memset(peer.recv_seen, 0, sizeof(peer.recv_seen));
+      peer.recv_max = seq;
+    } else if (peer.recv_max - seq >= kWindow) {
+      return false;
+    } else if (bit(seq) & (uint64_t(1) << (seq % 64))) {
+      return false;
+    }
+    bit(seq) |= uint64_t(1) << (seq % 64);
+    if (!second) ++peer.window_firsts;
+    ++peer.window_delivered;
+    return true;
+  }
+
+  // Every second: the share of first copies lost from each player (over at least 50
+  // datagrams), and auto redundancy towards each player. Second copies start when either
+  // side sees loss above 1% (the player's report of our datagrams, or unanswered pings) and
+  // stop after 30 s without any.
+  void UpdateRedundancy(OnlineClock::time_point now) {
+    const std::string mode = REXCVAR_GET(online_redundancy);
+    for (auto& peer : peers_) {
+      if (peer.receiving) {
+        const uint32_t expected = peer.recv_max - peer.window_start;
+        if (expected >= 50) {
+          const uint32_t firsts = std::min(peer.window_firsts, expected);
+          const uint32_t delivered = std::min(peer.window_delivered, expected);
+          peer.incoming_loss_pct = int((expected - firsts) * 100 + expected - 1) / int(expected);
+          peer.residual_loss_pct = int((expected - delivered) * 100 + expected - 1) / int(expected);
+          peer.total_expected += expected;
+          peer.total_firsts += firsts;
+          peer.total_delivered += delivered;
+          peer.window_start = peer.recv_max;
+          peer.window_firsts = 0;
+          peer.window_delivered = 0;
+        }
+      }
+      const bool fresh = peer.reported_loss_pct >= 0 && now - peer.reported_at < std::chrono::seconds(5);
+      const float loss = std::max(fresh ? peer.reported_loss_pct / 100.0f : 0.0f, Loss(peer, now));
+      if (loss > 0.01f) peer.last_loss = now;
+      bool want = false;
+      if (mode == "on") {
+        want = true;
+      } else if (mode != "off") {
+        want = peer.redundant ? now - peer.last_loss < std::chrono::seconds(30) : loss > 0.01f;
+      }
+      want = want && peer.tags;
+      if (want != peer.redundant) {
+        peer.redundant = want;
+        REXKRNL_INFO("Online: {} second copies of match datagrams to {} (loss {:.0f}%, {})",
+                     want ? "sending" : "no longer sending", peer.name, loss * 100.0f,
+                     mode.c_str());
+      }
+    }
+  }
+
+  void MarkDirect(Peer* peer, const sockaddr_in& from) {
+    if (!peer->direct || !SameEndpoint(peer->direct_addr, from)) {
+      REXKRNL_INFO("Online: direct connection to {} ({}:{})", peer->name,
+                   FormatAddress(ntohl(from.sin_addr.s_addr)), ntohs(from.sin_port));
+    }
+    peer->direct = true;
+    peer->direct_addr = from;
+    peer->last_direct = OnlineClock::now();
+  }
+
+  void Handle(uint8_t type, const uint8_t* body, size_t len, const sockaddr_in& from) {
+    Reader r{body, len};
+    uint32_t deliver_from = 0;
+    uint16_t src_port = 0, dst_port = 0;
+    const uint8_t* payload = nullptr;
+    size_t payload_len = 0;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      const bool from_server = SameEndpoint(from, server_);
+      if (from_server) last_server_ = OnlineClock::now();
+      switch (type) {
+        case kWelcome: {
+          if (!from_server) return;
+          const uint32_t id = r.u32();
+          const uint32_t vip = r.u32();
+          const uint64_t token = r.u64();
+          const std::string room = r.str();
+          const uint32_t public_ip = r.u32();
+          const uint16_t public_port = r.u16();
+          if (!r.ok) return;
+          id_ = id;
+          vip_ = vip;
+          token_ = token;
+          if (!welcomed_) {
+            REXKRNL_INFO("Online: joined {} as {} (seen as {}:{})",
+                         room.empty() ? "the public room" : "room " + room, FormatAddress(vip_),
+                         FormatAddress(public_ip), public_port);
+          }
+          welcomed_ = true;
+          state_ = "CONNECTED";
+          return;
+        }
+        case kMembers: {
+          if (!from_server || !welcomed_) return;
+          const uint16_t total = r.u16();
+          const uint16_t count = r.u16();
+          if (!r.ok || count > total || total > 254) return;
+          std::vector<Peer> listed;
+          for (uint16_t i = 0; i < count && r.ok; ++i) {
+            Peer peer;
+            peer.id = r.u32();
+            peer.vip = r.u32();
+            peer.token = r.u64();
+            const uint32_t pub_ip = r.u32();
+            const uint16_t pub_port = r.u16();
+            const uint32_t local_ip = r.u32();
+            const uint16_t local_port = r.u16();
+            peer.name = r.str();
+            peer.public_addr = Endpoint(pub_ip, pub_port);
+            peer.local_addr = Endpoint(local_ip, local_port);
+            listed.push_back(peer);
+          }
+          if (!r.ok) return;
+          room_players_ = total + 1;
+          // One MEMBERS message lists the whole room when it is small; larger rooms arrive in
+          // parts and only add players (the periodic refresh drops those who left).
+          const bool complete = count == total;
+          std::vector<Peer> next;
+          for (auto& peer : listed) {
+            auto it = std::find_if(peers_.begin(), peers_.end(),
+                                   [&](const Peer& p) { return p.id == peer.id && p.token == peer.token && p.vip == peer.vip; });
+            if (it != peers_.end()) {
+              it->public_addr = peer.public_addr;
+              it->local_addr = peer.local_addr;
+              it->name = peer.name;
+              it->last_listed = OnlineClock::now();
+              next.push_back(*it);
+            } else {
+              peer.seen = OnlineClock::now();
+              peer.last_listed = peer.seen;
+              REXKRNL_INFO("Online: {} is in the room ({})", peer.name, FormatAddress(peer.vip));
+              next.push_back(peer);
+            }
+          }
+          if (!complete) {
+            for (auto& peer : peers_) {
+              if (std::none_of(next.begin(), next.end(),
+                               [&](const Peer& p) { return p.id == peer.id; })) {
+                next.push_back(peer);
+              }
+            }
+          }
+          peers_ = std::move(next);
+          return;
+        }
+        case kStatus: {
+          if (!from_server) return;
+          room_players_ = r.u16();
+          players_online_ = int(r.u32());
+          r.u16();  // rooms
+          const uint16_t nearby = r.u16();
+          if (r.ok) nearby_players_ = nearby;
+          if (keepalive_pending_) {
+            keepalive_pending_ = false;
+            const int rtt = int(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                    OnlineClock::now() - last_keepalive_)
+                                    .count());
+            server_rtt_ms_ = server_rtt_ms_ < 0 ? rtt : (server_rtt_ms_ * 3 + rtt) / 4;
+          }
+          return;
+        }
+        case kError: {
+          if (!from_server) return;
+          const uint8_t code = r.u8();
+          const std::string text = r.str();
+          if (!r.ok) return;
+          REXKRNL_WARN("Online: server says: {} ({})", text, code);
+          if (code == 5 /* unknown client */) {
+            welcomed_ = false;
+            peers_.clear();
+            state_ = "RECONNECTING";
+          } else {
+            std::string upper = text;
+            for (auto& c : upper) c = char(std::toupper(static_cast<unsigned char>(c)));
+            state_ = upper;
+          }
+          return;
+        }
+        case kRelayed: {
+          if (!from_server || !welcomed_) return;
+          deliver_from = r.u32();
+          src_port = r.u16();
+          dst_port = r.u16();
+          if (!r.ok) return;
+          payload = body + r.pos;
+          payload_len = len - r.pos;
+          if (dst_port == kControlPort) {
+            for (auto& peer : peers_) {
+              if (peer.vip == deliver_from) HandleControl(&peer, payload, payload_len);
+            }
+            return;
+          }
+          if (src_port & kTaggedPort) {
+            auto it = std::find_if(peers_.begin(), peers_.end(),
+                                   [&](const Peer& p) { return p.vip == deliver_from; });
+            if (it == peers_.end() || !Untag(*it, src_port, payload, payload_len)) return;
+          }
+          break;
+        }
+        case kPunch:
+        case kPunchAck: {
+          if (relay_only_ || !welcomed_) return;
+          const uint32_t id = r.u32();
+          const uint64_t token = r.u64();
+          const uint32_t target = r.u32();
+          Peer* peer = r.ok && target == id_ ? FindPeer(id, token) : nullptr;
+          if (!peer) return;
+          MarkDirect(peer, from);
+          if (type == kPunch) {
+            Writer w(kPunchAck);
+            w.u32(id_);
+            w.u64(token_);
+            w.u32(peer->id);
+            SendRaw(from, w.data);
+          }
+          return;
+        }
+        case kDirect: {
+          if (relay_only_ || !welcomed_) return;
+          const uint32_t id = r.u32();
+          const uint64_t token = r.u64();
+          src_port = r.u16();
+          dst_port = r.u16();
+          Peer* peer = r.ok ? FindPeer(id, token) : nullptr;
+          if (!peer) return;
+          MarkDirect(peer, from);
+          deliver_from = peer->vip;
+          payload = body + r.pos;
+          payload_len = len - r.pos;
+          if (dst_port == kControlPort) {
+            HandleControl(peer, payload, payload_len);
+            return;
+          }
+          if ((src_port & kTaggedPort) && !Untag(*peer, src_port, payload, payload_len)) return;
+          break;
+        }
+        default:
+          return;
+      }
+    }
+    // Hand the datagram to the title's socket bound to that port.
+    if (payload_len > kMaxOnlinePayload) return;
+    std::lock_guard<std::mutex> lock(bound_mutex);
+    for (auto& [port, socket] : bound_sockets) {
+      if (port == dst_port) {
+        socket->DeliverOnline(deliver_from, src_port, payload, payload_len);
+        break;
+      }
+    }
+  }
+
+  OnlineClock::time_point last_redundancy_check_{};
+  std::mutex mutex_;
+  std::string mode_, room_;
+  std::string state_ = "OFF";
+  bool relay_only_ = false;
+  rex::net::SocketHandle fd_ = -1;
+  uint64_t socket_generation_ = 0;
+  OnlineClock::time_point last_send_error_{};
+  bool resolved_ = false;
+  bool welcomed_ = false;
+  sockaddr_in server_{};
+  uint16_t local_port_ = 0;
+  uint64_t hello_nonce_ = 0;
+  uint32_t id_ = 0, vip_ = 0;
+  uint64_t token_ = 0;
+  int room_players_ = 0, players_online_ = 0, nearby_players_ = 0;
+  int server_rtt_ms_ = -1;
+  bool keepalive_pending_ = false;
+  OnlineClock::time_point last_quality_log_{};
+  std::vector<Peer> peers_;
+
+  // Minutes east of UTC for the server's nearby matchmaking: the time zone, nothing finer.
+  static int UtcOffsetMinutes() {
+    const int configured = REXCVAR_GET(online_utc_offset);
+    if (configured > -10000) return configured;
+    const std::time_t now = std::time(nullptr);
+    std::tm local{};
+#if REX_PLATFORM_WIN32
+    if (localtime_s(&local,&now)!=0) return 0;
+    return int((_mkgmtime64(&local)-now)/60);
+#else
+    localtime_r(&now,&local);
+    return int(local.tm_gmtoff/60);
+#endif
+  }
+  OnlineClock::time_point last_hello_{}, last_keepalive_{}, last_server_{}, next_resolve_{};
+};
