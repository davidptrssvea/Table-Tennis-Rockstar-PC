+void RegisterBoundSocket(uint16_t port, XSocket* socket) {
+  std::lock_guard<std::mutex> lock(bound_mutex);
+  bound_sockets.erase(std::remove_if(bound_sockets.begin(), bound_sockets.end(),
+                                     [&](const auto& e) { return e.second == socket; }),
+                      bound_sockets.end());
+  if (port) bound_sockets.emplace_back(port, socket);
+}
