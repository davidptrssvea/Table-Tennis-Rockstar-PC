+namespace {
+std::mutex session_key_mutex;
+std::vector<std::array<uint8_t, 8>> session_keys;
+}  // namespace
+
+namespace {
+constexpr uint32_t kSessionHost = 0x001;
+constexpr uint32_t kSessionUsesMatchmaking = 0x008;
+constexpr uint32_t kSessionJoinInProgressDisabled = 0x400;
+std::mutex hosted_mutex;
+std::array<uint8_t, 60> hosted_lobby{}, hosted_match{};
+bool have_lobby = false, have_match = false;
+uint32_t lobby_flags = 0;
+}  // namespace
+
+void RegisterHostedSession(const uint8_t info[60], uint32_t flags) {
+  std::lock_guard<std::mutex> lock(hosted_mutex);
+  if (flags & kSessionUsesMatchmaking) {
+    std::memcpy(hosted_match.data(), info, 60);
+    have_match = true;
+  } else {
+    std::memcpy(hosted_lobby.data(), info, 60);
+    have_lobby = true;
+    have_match = false;  // a new lobby: any earlier match is over
+    lobby_flags = flags;
+  }
+}
+
+void HostedSessionModified(uint32_t flags) {
+  // The host's lobby is the hosted session without matchmaking (the match session's flags have
+  // the matchmaking bit).
+  if (!(flags & kSessionHost) || (flags & kSessionUsesMatchmaking)) return;
+  std::lock_guard<std::mutex> lock(hosted_mutex);
+  lobby_flags = flags;
+}
+
+bool RewriteSessionAnnouncement(const uint8_t* data, size_t size, std::vector<uint8_t>& out) {
+  // The title's search answer: tag D1 4A at offset 4, message type 0x62 at offset 11.
+  constexpr uint8_t kSearchAnswer = 0x62;
+  if (size < 12 + 60 || data[4] != 0xD1 || data[5] != 0x4A || data[11] != kSearchAnswer) return false;
+  std::lock_guard<std::mutex> lock(hosted_mutex);
+  if (!have_lobby || !have_match || !(lobby_flags & kSessionJoinInProgressDisabled)) return false;
+  const uint8_t* end = data + size;
+  const uint8_t* found = std::search(data, end, hosted_lobby.begin(), hosted_lobby.end());
+  if (found == end) return false;
+  out.assign(data, end);
+  std::memcpy(out.data() + (found - data), hosted_match.data(), 60);
+  static std::atomic<int> logged{0};
+  if (logged.fetch_add(1) < 3) {
+    REXKRNL_INFO("XNet: search answer names match session {:016X} instead of lobby {:016X}",
+                 memory::load_and_swap<uint64_t>(hosted_match.data()),
+                 memory::load_and_swap<uint64_t>(hosted_lobby.data()));
+  }
+  return true;
+}
+
+void RegisterSessionKey(const uint8_t kid[8]) {
+  std::array<uint8_t, 8> key;
+  std::memcpy(key.data(), kid, 8);
+  std::lock_guard<std::mutex> lock(session_key_mutex);
+  session_keys.erase(std::remove(session_keys.begin(), session_keys.end(), key), session_keys.end());
+  session_keys.push_back(key);
+}
+
+void UnregisterSessionKey(const uint8_t kid[8]) {
+  std::array<uint8_t, 8> key;
+  std::memcpy(key.data(), kid, 8);
+  std::lock_guard<std::mutex> lock(session_key_mutex);
+  session_keys.erase(std::remove(session_keys.begin(), session_keys.end(), key), session_keys.end());
+}
