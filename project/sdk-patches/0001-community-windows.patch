+        }
+        if (now - last_quality_log_ > std::chrono::seconds(10)) {
+          last_quality_log_ = now;
+          for (const auto& peer : peers_) {
+            REXKRNL_INFO("Online: {} round trip {} ms, loss {:.0f}% (datagrams from it {}%, "
+                         "both copies {}%; to it {}%), {}{} (server {} ms)",
+                         peer.name, peer.rtt_ms < 0 ? -1 : int(peer.rtt_ms + 0.5),
+                         Loss(peer, now) * 100.0f, peer.incoming_loss_pct,
+                         peer.residual_loss_pct, peer.reported_loss_pct,
+                         peer.direct && !relay_only_ ? "direct" : "through the server",
+                         peer.redundant ? ", sending second copies" : "", server_rtt_ms_);
+            if (peer.total_expected) {
+              const double expected = double(peer.total_expected);
+              REXKRNL_INFO("Online: from {} so far: {} datagrams, first copies lost {:.2f}%, both "
+                           "copies lost {:.2f}%",
+                           peer.name, peer.total_expected,
+                           100.0 * (expected - double(peer.total_firsts)) / expected,
+                           100.0 * (expected - double(peer.total_delivered)) / expected);
+            }
+          }
+        }
+        if (now - last_server_ > std::chrono::seconds(15)) {
+          REXKRNL_WARN("Online: lost the server, reconnecting");
+          welcomed_ = false;
+          peers_.clear();
+          state_ = "RECONNECTING";
+        }
+        Punch(now);
+      }
+      const auto fd = fd_;
+      lock.unlock();
+
+#if REX_PLATFORM_WIN32
+      WSAPOLLFD poll_fd{SOCKET(fd),POLLRDNORM,0};
+      if (WSAPoll(&poll_fd,1,50)<=0) continue;
+#else
+      pollfd poll_fd{int(fd), POLLIN, 0};
+      if (poll(&poll_fd,1,50)<=0) continue;
+#endif
