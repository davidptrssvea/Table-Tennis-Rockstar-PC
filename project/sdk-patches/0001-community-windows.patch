+uint32_t ParseAddress(const std::string& text) {
+  in_addr addr{};
+  if (inet_pton(AF_INET, text.c_str(), &addr) != 1) return 0;
+  return ntohl(addr.s_addr);
+}
+
+// The source address the host uses for its default route; no packet is sent.
+uint32_t DefaultRouteAddress() {
+  rex::net::SocketHandle fd = ::socket(AF_INET, SOCK_DGRAM, 0);
+  if (fd < 0) return 0;
+  sockaddr_in to{};
+  to.sin_family = AF_INET;
+  to.sin_port = htons(9);
+  to.sin_addr.s_addr = htonl(0x08080808);
+  uint32_t result = 0;
+  if (::connect(fd, reinterpret_cast<sockaddr*>(&to), sizeof(to)) == 0) {
+    sockaddr_in local{};
+    socklen_t len = sizeof(local);
+    if (::getsockname(fd, reinterpret_cast<sockaddr*>(&local), &len) == 0) {
+      result = ntohl(local.sin_addr.s_addr);
+    }
+  }
+  rex::net::socket_close(fd);
+  return result;
+}
+
+std::string HexDump(const uint8_t* data, size_t len) {
+  std::string out;
+  for (size_t i = 0; i < len; ++i) out += fmt::format("{:02X}", data[i]);
+  return out;
+}
+
+std::string FormatAddress(uint32_t address) {
+  in_addr addr{}; addr.s_addr=htonl(address);
+  char text[INET_ADDRSTRLEN] = {};
+  inet_ntop(AF_INET, &addr, text, sizeof(text));
+  return text;
+}
+}  // namespace
+
+uint32_t OnlineAddress();
+
+// The machine's own address: net_address, or the source address of the default route.
+uint32_t BaseAddress() {
+  static const uint32_t address = [] {
+    uint32_t result = ParseAddress(REXCVAR_GET(net_address));
+    if (!result) result = DefaultRouteAddress();
+    if (!result) result = INADDR_LOOPBACK;
+    REXKRNL_INFO("XNet: local address {} (port offset {})", FormatAddress(result),
+                 REXCVAR_GET(net_port_offset));
+    return result;
+  }();
+  return address;
+}
+
+uint32_t LocalAddress() {
+  const uint32_t online = OnlineAddress();
+  return online ? online : BaseAddress();
+}
+
+bool BindLocalAddress() {
+  return (BaseAddress() >> 24) == 127;
+}
+
+const std::vector<uint32_t>& BroadcastPeers() {
+  static const std::vector<uint32_t> peers = [] {
+    std::vector<uint32_t> result;
+    std::string list = REXCVAR_GET(net_peers);
+    size_t start = 0;
+    while (start <= list.size()) {
+      size_t end = list.find(',', start);
+      if (end == std::string::npos) end = list.size();
+      if (uint32_t address = ParseAddress(list.substr(start, end - start))) {
+        result.push_back(address);
+        REXKRNL_INFO("XNet: broadcasts go to {}", FormatAddress(address));
+      }
+      start = end + 1;
+    }
+    return result;
+  }();
+  return peers;
+}
+
+uint16_t HostPort(uint16_t guest_port) {
+  if (!guest_port) return 0;
+  return static_cast<uint16_t>(guest_port + REXCVAR_GET(net_port_offset));
+}
+
+uint16_t GuestPort(uint16_t host_port) {
+  if (!host_port) return 0;
+  return static_cast<uint16_t>(host_port - REXCVAR_GET(net_port_offset));
+}
